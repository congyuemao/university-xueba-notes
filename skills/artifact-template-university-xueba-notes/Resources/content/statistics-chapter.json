      "entries": [
        {
          "term_en": "sample space",
          "meaning_zh": "随机试验全部可能结果组成的集合。"
        },
        {
          "term_en": "event",
          "meaning_zh": "样本空间中可赋予概率的结果集合。"
        },
        {
          "term_en": "joint probability",
          "meaning_zh": "两个或多个事件同时发生的概率。"
        },
        {
          "term_en": "conditional probability",
          "meaning_zh": "已知一个事件发生后，另一事件在限定群体中的概率。"
        },
        {
          "term_en": "multiplication rule",
          "meaning_zh": "用边际概率与相应条件概率计算联合概率的公式。"
        },
        {
          "term_en": "partition",
          "meaning_zh": "对样本空间作出的互斥且完备的事件划分。"
        },
        {
          "term_en": "law of total probability",
          "meaning_zh": "按一个划分汇总各来源概率的公式。"
        },
        {
          "term_en": "Bayes’ theorem",
          "meaning_zh": "依据观测证据更新来源概率的公式。"
        },
        {
          "term_en": "prior probability",
          "meaning_zh": "纳入当前证据之前对事件给出的概率。"
        },
        {
          "term_en": "likelihood",
          "meaning_zh": "给定某种状态时，观测证据出现的概率。"
        },
        {
