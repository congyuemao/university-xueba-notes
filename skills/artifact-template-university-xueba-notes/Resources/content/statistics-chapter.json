  "concepts": [
    {
      "id": "conditional-probability",
      "topic": "conditional_probability",
      "core": true,
      "prerequisite_ids": [],
      "definition": "在P(B)>0时，P(A|B)=P(A∩B)/P(B)。",
      "plain_explanation": "已知B发生后，只在B限定的群体内重新计算A所占的比例。",
      "boundary": "P(B)必须大于0，且P(A|B)与P(B|A)通常不同。",
      "canonical_example": "检测表中P(D|F)以全部被标记组件为分母，P(F|D)以全部缺陷组件为分母。"
    },
    {
      "id": "total-probability",
      "topic": "total_probability",
      "core": true,
      "prerequisite_ids": [
        "conditional-probability"
      ],
      "definition": "若A₁,…,Aₘ构成样本空间的划分，则P(B)=ΣP(Aᵢ)P(B|Aᵢ)。",
      "plain_explanation": "先按互斥且完整的来源分组，再把各来源产生目标事件的概率加总。",
      "boundary": "分组必须互斥且完整，各条件概率的分母须为正。",
      "canonical_example": "三条产线按50%、30%、20%供货，缺陷率按供货比例加权得到总体缺陷率2.4%。"
    },
    {
      "id": "bayes-theorem",
      "topic": "bayes_theorem",
      "core": true,
      "prerequisite_ids": [
        "total-probability"
      ],
      "definition": "P(Aₖ|B)=P(Aₖ)P(B|Aₖ)/ΣP(Aᵢ)P(B|Aᵢ)。",
      "plain_explanation": "观察到证据B后，用各来源产生该证据的联合概率重新分配来源概率。",
      "boundary": "来源事件须构成划分且P(B)>0。",
      "canonical_example": "在缺陷件中，供应量较小但缺陷率较高的A₃产线占比由20%更新为41.67%。"
    },
    {
      "id": "likelihood-ratio",
      "topic": "likelihood_ratio",
      "core": true,
      "prerequisite_ids": [
        "bayes-theorem"
      ],
      "definition": "似然比LR=P(F|D)/P(F|D^c)，后验几率等于先验几率乘以LR。",
      "plain_explanation": "同一证据在两种状态下出现得越不一样，它改变判断的力量越大。",
      "boundary": "分母须为正；重复证据只有在给定真实状态后条件独立时才能直接连乘。",
      "canonical_example": "检出率0.90、误报率0.10时LR=9，先验几率1/19更新为后验几率9/19。"
    },
    {
      "id": "event-independence",
      "topic": "event_independence",
      "core": true,
      "prerequisite_ids": [
        "conditional-probability"
      ],
      "definition": "若P(A∩B)=P(A)P(B)，则A与B独立。",
      "plain_explanation": "知道一个事件发生不会改变另一个事件的概率。",
      "boundary": "事件名称或发生时间不同不能证明独立；正概率互斥事件必不独立。",
      "canonical_example": "不放回抽样中P(D₂|D₁)=3/9与P(D₂)=4/10不同，因此两次结果不独立。"
    },
    {
      "id": "mutual-independence",
      "topic": "mutual_independence",
      "core": true,
      "prerequisite_ids": [
        "event-independence"
      ],
      "definition": "三个事件相互独立时，每一对及三重交集都满足相应概率乘积式。",
      "plain_explanation": "逐对互不影响仍不足以保证三个事件放在一起也互不影响。",
      "boundary": "两两独立不能代替相互独立。",
      "canonical_example": "两枚硬币构造的A、B、C每对交集概率为1/4，但三重交集为1/4而非1/8。"
    }
  ],
