          "meaning_zh": "不能同时发生的事件。"
        },
        {
          "term_en": "conditional independence",
          "meaning_zh": "给定某个条件后，两个事件彼此独立。"
        },
        {
          "term_en": "pairwise independence",
          "meaning_zh": "一组事件中的每一对都相互独立。"
        },
        {
          "term_en": "mutual independence",
          "meaning_zh": "一组事件的全部有限交集都满足乘积关系。"
        }
